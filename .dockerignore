# Use an allowlist so datasets, artifacts, reports, tests, VCS metadata,
# local environments, and arbitrary images never enter the build context.
**

!.dockerignore
!Dockerfile.template
!requirements-runtime.txt

!app/
!app/**

!scripts/
!scripts/predict_mushroom_health.py

!models/
!models/model-manifest.json

!runtime/
!runtime/models/
!runtime/models/detector/
!runtime/models/detector/best.pt
!runtime/models/health/
!runtime/models/health/best.pt

# Re-exclude generated bytecode that may exist below the allowed app tree.
**/__pycache__/
**/*.py[cod]
