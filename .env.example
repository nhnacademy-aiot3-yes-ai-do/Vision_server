# Empty model paths use the repository-local artifacts defaults.
# Docker/Kubernetes should set:
#   DETECTOR_MODEL_PATH=/models/detector/best.pt
#   HEALTH_MODEL_PATH=/models/health/best.pt
DETECTOR_MODEL_PATH=
HEALTH_MODEL_PATH=

HEALTH_DETECTION_CONFIDENCE=0.25
HEALTH_MIN_DETECTION_CONFIDENCE=0.50
HEALTH_UNCERTAIN_THRESHOLD=0.70
HEALTH_PADDING_RATIO=0.15
HEALTH_MAX_UPLOAD_BYTES=10485760
HEALTH_VERIFY_MODEL_SHA256=true
# Apple Silicon Mac: mps (or cpu if MPS is unsuitable)
# Linux CPU: cpu
# Linux NVIDIA GPU: cuda:0
# auto delegates selection to Ultralytics and does not guarantee MPS selection.
HEALTH_DEVICE=auto
