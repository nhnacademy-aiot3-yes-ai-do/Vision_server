# 로컬 실행용 공개 설정 예시이다. 실제 비밀번호나 MinIO 인증정보는 넣지 않는다.
# 애플리케이션은 .env를 자동 로딩하지 않으므로 필요하면 shell에서 export한다.
DETECTOR_MODEL_PATH=runtime/models/detector/best.pt
HEALTH_MODEL_PATH=runtime/models/health/best.pt

# detector 후보 채택 → 건강 분류 허용 → 건강 결과 확정의 세 단계 임계값이다.
HEALTH_DETECTION_CONFIDENCE=0.25
HEALTH_MIN_DETECTION_CONFIDENCE=0.50
HEALTH_UNCERTAIN_THRESHOLD=0.70
HEALTH_PADDING_RATIO=0.15
HEALTH_MAX_UPLOAD_BYTES=10485760
HEALTH_VERIFY_MODEL_SHA256=true

# Apple Silicon Mac: mps 또는 cpu
# Linux CPU: cpu / Linux NVIDIA GPU: cuda:0
HEALTH_DEVICE=auto
