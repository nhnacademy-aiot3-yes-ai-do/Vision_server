# 로컬 실행용 공개 설정 예시이다. 실제 비밀번호나 MinIO 인증정보는 넣지 않는다.
# 애플리케이션은 .env를 자동 로딩하지 않으므로 필요하면 shell에서 export한다.


DETECTOR_MODEL_PATH=runtime/models/detector/best.pt  # 이미지에서 버섯 품종과 bbox를 찾는 detector 가중치 파일의 경로이다.
HEALTH_MODEL_PATH=runtime/models/health/best.pt  # detector가 잘라낸 품종별 영역을 건강/병해 의심으로 분류하는 가중치 경로이다.


HEALTH_DETECTION_CONFIDENCE=0.25  # detector가 반환한 bbox를 분석 후보로 채택할 최소 신뢰도이다.
HEALTH_MIN_DETECTION_CONFIDENCE=0.50  # 같은 품종 그룹의 최저 탐지 신뢰도가 이 값보다 낮으면 건강 분류를 건너뛴다.
HEALTH_UNCERTAIN_THRESHOLD=0.70  # 건강/병해 의심 중 가장 높은 분류 확률이 이 값 미만이면 UNCERTAIN으로 처리한다.
HEALTH_PADDING_RATIO=0.15  # union bbox 사방에 더할 여백 비율이다. bbox가 아니라 원본 이미지 크기를 기준으로 한다.

HEALTH_MAX_UPLOAD_BYTES=10485760  # 요청 한 건에서 허용할 업로드 이미지의 최대 byte 크기이다.
HEALTH_MAX_INFLIGHT_REQUESTS=1  # 프로세스 한 개가 동시에 bytes/PIL 이미지를 보유하며 처리할 요청 수이다.

HEALTH_VERIFY_MODEL_SHA256=true  # 시작할 때 모델 파일 SHA-256을 manifest의 승인값과 비교할지 결정한다.
HEALTH_DEVICE=auto  # 추론 장치이다. Apple Silicon은 mps/cpu, Linux CPU는 cpu, NVIDIA는 cuda:0을 쓴다.
