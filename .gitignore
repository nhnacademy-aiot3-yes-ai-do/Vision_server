# Archives must not be used as repository or Docker inputs
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# Generated reports, training runs, artifacts, and logs
reports/*.csv
artifacts/
runs/
weights/
*.log

# Model files: runtime directories may keep tracked documentation only
runtime/models/*.pt
runtime/models/**/*.pt
*.pt
*.pth
*.onnx
*.engine
*.ckpt
*.safetensors

