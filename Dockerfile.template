# syntax=docker/dockerfile:1.7
#
# Linux deployment prototype only; this is not a macOS/MPS image.
# The team must approve and pass BASE_IMAGE.
# TODO(BASE_IMAGE): pin an immutable Python 3.12/PyTorch image digest.
# TODO(GPU): decide CPU or CUDA runtime after the deployment target is fixed.
# The base must already contain a compatible torch/torchvision pair.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG APP_UID=10001
ARG APP_GID=10001

USER 0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp/mushroom-home \
    YOLO_CONFIG_DIR=/tmp/mushroom-yolo \
    MPLCONFIGDIR=/tmp/mushroom-matplotlib \
    TORCH_HOME=/tmp/mushroom-torch \
    XDG_CACHE_HOME=/tmp/mushroom-cache \
    DETECTOR_MODEL_PATH=/models/detector/best.pt \
    HEALTH_MODEL_PATH=/models/health/best.pt \
    HEALTH_VERIFY_MODEL_SHA256=true

WORKDIR /opt/mushroom-vision

# requirements-runtime contains platform-neutral service packages. The approved
# Linux base supplies torch/torchvision; pip must not replace them with a Mac
# wheel or an unapproved CUDA build. Do not place package-index credentials in
# this file or in build arguments.
COPY requirements-common.txt ./requirements-common.txt
COPY requirements-runtime.txt ./requirements-runtime.txt
RUN python -c "import torch, torchvision"
RUN python -m pip install --no-cache-dir -r requirements-runtime.txt

# Copy only the runtime surface. The allowlist in .dockerignore keeps datasets,
# reports, tests, local environments, and arbitrary artifacts out of context.
COPY app ./app
COPY scripts/predict_mushroom_health.py ./scripts/predict_mushroom_health.py
COPY models/model-manifest.json ./models/model-manifest.json

# `scripts/prepare_runtime_models.py` verifies size and SHA-256 before these
# files enter the build context. Keep the runtime copies owned by root so the
# unprivileged API process cannot chmod or replace them. If either COPY source
# is missing, run `make prepare-models` before rebuilding.
COPY runtime/models/detector/best.pt /models/detector/best.pt
COPY runtime/models/health/best.pt /models/health/best.pt
RUN chmod 0444 \
        /models/detector/best.pt \
        /models/health/best.pt \
        models/model-manifest.json \
    && chmod -R a-w app scripts models \
    && chmod 0555 /models /models/detector /models/health

# A numeric identity does not depend on distribution-specific user-management
# commands in the still-undecided BASE_IMAGE.
USER ${APP_UID}:${APP_GID}

EXPOSE 8000

# The lifespan loads both models before the socket becomes ready. A single
# worker is mandatory because each worker would allocate another model pair.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3).read(1)"]

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
